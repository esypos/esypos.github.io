{
  "name": "Old POS – Free Offline POS Software",
  "short_name": "Old POS",
  "description": "Free offline POS app for small shops: billing, barcode scan, stock, customer due, expenses, reports and Google Drive backup.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#1e40af",
  "theme_color": "#1e40af",
  "categories": [
    "business",
    "finance",
    "productivity",
    "shopping"
  ],
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "assets/screenshots/02-dashboard.png",
      "sizes": "810x1800",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Dashboard"
    },
    {
      "src": "assets/screenshots/03-products.png",
      "sizes": "810x1800",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Products and stock"
    },
    {
      "src": "assets/screenshots/04-customers.png",
      "sizes": "810x1800",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Customers and due"
    },
    {
      "src": "assets/screenshots/08-reports.png",
      "sizes": "810x1800",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Reports"
    },
    {
      "src": "assets/screenshots/desktop-02-dashboard.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard"
    },
    {
      "src": "assets/screenshots/desktop-11-users.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Users"
    },
    {
      "src": "assets/screenshots/desktop-03-products.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Products and stock"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "New sale",
      "short_name": "Sell",
      "description": "Open the sales counter",
      "url": "./index.html?go=pos",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Products",
      "short_name": "Products",
      "description": "Manage products and stock",
      "url": "./index.html?go=products",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Customers & due",
      "short_name": "Customers",
      "description": "Customer ledger and dues",
      "url": "./index.html?go=customers",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Reports",
      "short_name": "Reports",
      "description": "Sales and profit reports",
      "url": "./index.html?go=reports",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Sales history",
      "short_name": "History",
      "description": "Past bills and returns",
      "url": "./index.html?go=history",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Expenses",
      "short_name": "Expenses",
      "description": "Record shop expenses",
      "url": "./index.html?go=expenses",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred"
}